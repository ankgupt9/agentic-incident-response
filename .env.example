# Copy to .env (gitignored) and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Protects the approval and kill-switch endpoints. If empty they stay disabled.
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
AGENT_ADMIN_TOKEN=
# Optional
# POSTGRES_PASSWORD=          (defaults to a throwaway local password)
# GITHUB_TOKEN=               (fine-grained, this repo only; without it draft PRs stay dry-run)
# AGENT_ACTIONS_DRY_RUN=false (real execution of approved actions; the default is a dry run)
